# Local `npm run dev` uses data/db.json when DATABASE_URL is empty.
# When set (local or Vercel), the directory always reads this Postgres URI — never a JSON fallback.
# After pointing local at Supabase, run `npm run sync:catalog` to copy missing tools from data/db.json.
# Vercel: set this to the Supabase Transaction pooler URI (port 6543).
# Example: postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Optional alias used by some Vercel Postgres integrations
POSTGRES_URL=

# Admin login on Vercel (optional). Falls back to the default local password if unset.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

GEMINI_API_KEY=
